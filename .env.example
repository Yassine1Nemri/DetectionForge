# Compose requires a local password. Replace this placeholder before starting.
POSTGRES_DB=detectionforge
POSTGRES_USER=detectionforge
POSTGRES_PASSWORD=replace-with-a-local-password
# Native backend: replace with the same local PostgreSQL password; URL-encode special characters.
# DATABASE_URL=postgresql+psycopg://detectionforge:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/detectionforge
# Explicit lightweight local mode (default); run Alembic from the repository root.
DATABASE_URL=sqlite:///./detectionforge.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SPLUNK_FIELD_MAPPINGS={"EventID":"EventCode"}
# Phase 1 has no Splunk credentials or connector. Never put credentials in frontend variables.
